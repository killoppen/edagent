        {"id":"event:rag:03","kind":"event","eventType":"activity","lane":"知识工程","sequenceHint":3,"label":"解析、分块并附加元数据与权限","summary":"保留来源定位和版本，处理重复、解析失败、结构差异和访问控制。","taskRefs":["task:llmapp:build-rag"],"actorRefs":["actor:rag:llm-engineer"],"objectRefs":["object:rag:changed-sources"],"artifactRefs":["artifact:rag:ingestion-record"],"toolRefs":["tool:rag:pipeline"],"claimIds":["CLM-T05","CLM-KS03"]},
        {"id":"event:rag:04","kind":"event","eventType":"activity","lane":"检索工程","sequenceHint":4,"label":"构建影子索引并执行检索","summary":"使用新版本配置构建隔离索引，对受影响和回归查询运行召回、过滤与重排。","taskRefs":["task:llmapp:build-rag"],"actorRefs":["actor:rag:llm-engineer"],"objectRefs":["object:rag:queries-qrels"],"artifactRefs":["artifact:rag:index-version"],"toolRefs":["tool:rag:pipeline"],"claimIds":["CLM-T05","CLM-T06"]},

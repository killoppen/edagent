      "acceptanceCriteria": ["来源资格和版本可追溯", "片段保留来源、元数据与权限", "检索评价覆盖受影响查询", "发布和回滚不破坏既有权限与引用"],
      "claimIds": ["CLM-T05", "CLM-T06", "CLM-T11", "CLM-T15"],
      "nodes": [

        {"id":"object:rag:changed-sources","kind":"work_object","label":"新增或变更的知识来源","summary":"带发布者、时间、版本、适用范围和访问规则的资料。","claimIds":["CLM-T05"]},
        {"id":"object:rag:queries-qrels","kind":"work_object","label":"查询与相关文档标注","summary":"覆盖典型、边缘、受影响查询及其相关文档判断。","claimIds":["CLM-T06"]},
        {"id":"artifact:rag:ingestion-record","kind":"artifact","label":"摄取与权限记录","summary":"记录来源、解析、分块、元数据、权限、失败和版本。","claimIds":["CLM-T05"]},
        {"id":"artifact:rag:index-version","kind":"artifact","label":"可回退索引版本","summary":"与摄取配置、embedding、过滤和重排配置绑定的索引。","claimIds":["CLM-T05"]},
